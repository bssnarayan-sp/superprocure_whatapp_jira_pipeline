    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE support_messages\nSET\n    jira_synced = TRUE,\n    jira_synced_at = NOW()\nWHERE message_id = ANY(\n    string_to_array($1, ',')\n);\n\nUPDATE support_threads\nSET\n    updated_at = NOW()\nWHERE thread_id = $2;",
        "options": {
          "queryReplacement": "={{\n[\n  $(\"Build JIRA Comment\").item.json.messageIdsCsv,\n  $(\"Build JIRA Comment\").item.json.threadId\n]\n}}"
        }
      },
