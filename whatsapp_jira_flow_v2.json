    {
      "parameters": {
        "jsCode": "const issue = JSON.parse($json.text);\n\nconst thread = $node[\"Normalize Threads\"].json;\n\nreturn [\n  {\n    json: {\n      threadId: thread.threadId,\n      sender: thread.sender,\n      timestamp: thread.timestamp,\n      originalText: thread.text,\n      messages: thread.messages,\n      jiraKey: thread.jiraKey,\n\n      classification: \"bug\",\n\n      summary: issue.summary,\n      description: issue.description,\n      customer: issue.customer,\n      module: issue.module,\n      severity: issue.severity,\n      referenceIds: issue.reference_ids || []\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        656,
        -592
      ],
      "id": "bf6a8cf9-b836-4d59-b055-63c20285990b",
      "name": "Parse LLM Response"
    },
    {
      "parameters": {
        "inputText": "={{ $json.text }}",
        "categories": {
          "categories": [
            {
              "category": "bug",
              "description": "incorrect/failing product behavior or major production/service disruption"
            },
            {
              "category": "support_query",
              "description": "question or clarification"
            },
            {
              "category": "noise",
              "description": "acknowledgement, FYI, unrelated, or insufficient information"
            }
          ]
        },
        "options": {
          "fallback": "discard",
          "systemPromptTemplate": "You are classifying messages from a software product support WhatsApp group.\n\nChoose the single category that best represents the intent of the message.\n\nPay attention to whether the message describes incorrect system behavior, a production impact, a support question, an operational action request, or merely acknowledgement/noise.\n\nDo not assume that words such as \"priority\", \"urgent\", or mentions of people automatically mean an incident.\n\nIf a message cannot be understood without a previous message or quoted context, choose the closest category based only on the available text."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.textClassifier",
      "typeVersion": 1.1,
      "position": [
        -192,
        -512
      ],
      "id": "331dd70a-cc10-469c-a371-f6cd66eb1099",
      "name": "Classify Message",
      "alwaysOutputData": false
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "af166810-177e-46e6-9dd8-92022a45a28e",
              "name": "classification",
              "value": "support",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        192,
        -400
      ],
      "id": "412f8401-02e4-4f64-9f10-f77dec6f1607",
      "name": "Set Classification - Support"
    },
    {
      "parameters": {
        "jsCode": "const thread = $node[\"Normalize Threads\"].json;\n\nlet messages = thread.unsyncedMessages || [];\n\nif (typeof messages === \"string\") {\n  messages = JSON.parse(messages);\n}\n\nconst jiraComment = messages\n  .map(\n    m => `[${m.timestamp}] ${m.sender}: ${m.text}`\n  )\n  .join(\"\\n\\n\");\n\nconst messageIdsCsv = messages\n  .map(m => m.messageId)\n  .join(\",\");\n\nreturn [\n  {\n    json: {\n      ...thread,\n      unsyncedMessages: messages,\n      jiraComment,\n      messageIdsCsv\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        48,
        32
      ],
      "id": "5ae70d02-4ebc-4a6b-962f-eb2445f675a9",
      "name": "Build JIRA Comment"
